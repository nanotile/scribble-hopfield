{
  "project_name": "GPU-Enhanced Scribble Plotter",
  "version": "4.0-local",
  "author": "Kent Benson",
  "inspiration": "1983-1986 Hopfield Network Research",
  "total_examples": 1,
  "batch_size": 8,
  "generate_pdf": true,
  "generate_dxf": true,
  "generate_png": true,
  "generate_svg": true,
  "organize_groups": false,
  "output_dpi": 300,
  "page_width": 800,
  "page_height": 600,
  "scale_factor_x": 0.09,
  "scale_factor_y": 0.09,
  "scale_factor_z": 1.0,
  "use_ai_parameters": false,
  "ai_confidence_threshold": 0.7,
  "use_hopfield_memory": false,
  "hopfield_memory_size": 200,
  "hopfield_pattern_size": 15,
  "create_random": true,
  "random_steps_upper_limit": 15,
  "scribble_upper_limit": 8,
  "steps_fixed": 5,
  "scribble_fixed": 3.0,
  "stroke_weight_value": 3.0,
  "gpu_memory_fraction": 0.8,
  "enable_mixed_precision": true,
  "optimize_memory": true,
  "steps_override": 8
}